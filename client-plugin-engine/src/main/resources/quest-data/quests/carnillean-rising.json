    {
      "title": "Getting started",
      "text": "Outside the Carnillean Mansion south-west of East Ardougne, to talk to Xenia.",
      "actions": [
        {
          "t": "conversationHighlight",
          "text": "Yes, I remember you."
        },
        {
          "t": "conversationHighlight",
          "text": "Thanks for fixing it!"
        }
      ],
      "postconditions": [
        {
          "t": "questInterfaceOpen"
        }
      ],
      "jumpconditions": [],
      "jumpOffset": 0,
      "neededItems": [],
      "recommendedItems": []
    },
    {
      "text": "[Accept Quest]",
      "actions": [],
