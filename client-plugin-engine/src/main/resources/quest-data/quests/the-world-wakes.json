    {
      "text": "Talk to Sliske.",
      "actions": [
        {
          "t": "conversationHighlight",
          "text": "stand before you! Do your worst!"
        },
        {
          "t": "conversationHighlight",
          "text": "What does this mean?"
        },
        {
          "t": "conversationHighlight",
          "text": "What do you mean, trouble?"
        },
        {
          "t": "conversationHighlight",
          "text": "Okay then."
        }
      ],
      "postconditions": [
        {
          "t": "conversationText",
          "text": "a reminder of his edicts"
        }
      ],
      "jumpconditions": [],
      "jumpOffset": 0,
      "neededItems": [],
      "recommendedItems": []
    },
    {
      "text": "Continue talking to Sliske after the cutscene.",
      "actions": [
        {
          "t": "conversationHighlight",
          "text": "What do you gain from telling me this?"
        },
        {
          "t": "conversationHighlight",
          "text": "So how do I come into this?"
        },
        {
          "t": "conversationHighlight",
          "text": "I already know my decision."
        },
        {
          "t": "conversationHighlight",
          "text": "better get going"
        }
      ],
      "postconditions": [
        {
          "t": "conversationText",
          "text": "too late"
        }
      ],
      "jumpconditions": [],
      "jumpOffset": 0,
      "neededItems": [],
      "recommendedItems": []
    },
    {
      "text": "If Kree\u0027arra and Commander Zilyana don\u0027t spawn, talk to Sliske again.",
      "actions": [],
      "postconditions": [
        {
          "t": "modelVisible",
          "kind": "npc",
          "typeId": 16921,
