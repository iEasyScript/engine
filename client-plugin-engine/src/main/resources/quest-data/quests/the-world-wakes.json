    {
      "title": "Defeating Kree\u0027arra",
      "text": "After the cutscenes, talk to Kree\u0027arra.",
      "actions": [
        {
          "t": "conversationHighlight",
          "text": "Why are you following Zilyana, then?"
        },
        {
          "t": "conversationHighlight",
          "text": "If you want to get rid of me, you\u0027ll have to do it the hard way."
        },
        {
          "t": "modelHighlight",
          "kind": "npc",
          "typeId": 16923,
          "modelIds": [],
          "displayName": "Kree\u0027arra"
