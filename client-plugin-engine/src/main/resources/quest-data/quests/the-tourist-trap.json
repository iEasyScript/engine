        {
          "t": "modelHighlight",
          "kind": "npc",
          "typeId": 830,
          "modelIds": [
            5211
          ],
          "displayName": "Mercenary Captain"
        },
        {
          "t": "conversationHighlight",
          "text": "Wow! A real captain!"
        },
        {
          "t": "conversationHighlight",
          "text": "I'd love to work for a tough guy like you!"
        },
        {
          "t": "conversationHighlight",
          "text": "Can't I do something for a strong Captain like you?"
        },
        {
          "t": "conversationHighlight",
          "text": "Sorry Sir, I don't think I can do that."
        },
        {
          "t": "conversationHighlight",
          "text": "It's a funny captain who can't fight his own battles!"
        }
