    {
      "text": "Adjust the machines next to Oldak, use combination 9-4-1, activate the machine.",
      "actions": [],
      "postconditions": [],
      "jumpconditions": [],
      "jumpOffset": 0,
      "neededItems": [],
      "recommendedItems": []
    },
    {
      "text": "Open the strange box in the north-western part of Yu'biusk for a cutscene.",
      "actions": [],
      "postconditions": [],
      "jumpconditions": [],
      "jumpOffset": 0,
      "neededItems": [],
      "recommendedItems": []
