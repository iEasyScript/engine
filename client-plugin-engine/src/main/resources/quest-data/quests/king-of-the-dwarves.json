      ],
      "postconditions": [],
      "jumpconditions": [],
      "jumpOffset": 0,
      "neededItems": [],
      "recommendedItems": []
    },
    {
      "text": "Talk to My Arm .",
      "actions": [
        {
          "t": "conversationHighlight",
          "text": "How can I get Pretty Flower to listen to me?"
