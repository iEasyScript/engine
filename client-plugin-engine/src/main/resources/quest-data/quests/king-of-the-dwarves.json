      "jumpOffset": 0,
      "neededItems": [],
      "recommendedItems": []
    },
    {
      "title": "Defeating Colonel Grimsson",
      "text": "Talk to Veldaban.",
      "actions": [
        {
          "t": "conversationHighlight",
          "text": "Can you show me the way to the Barendir caverns?"
