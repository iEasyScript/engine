      "postconditions": [],
      "jumpconditions": [],
      "jumpOffset": 0,
      "neededItems": [],
      "recommendedItems": []
    },
    {
      "text": "Talk to Pretty Flower.",
      "actions": [
        {
          "t": "conversationHighlight",
          "text": "We want you to help defend Keldagrim from chaos dwarves."
        },
        {
          "t": "conversationHighlight",
          "text": "Take a look at this pretty flower..."
