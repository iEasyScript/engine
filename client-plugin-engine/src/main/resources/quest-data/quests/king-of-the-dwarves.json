      ],
      "postconditions": [],
      "jumpconditions": [],
      "jumpOffset": 0,
      "neededItems": [],
      "recommendedItems": []
    },
    {
      "text": "Lift the big rock opposite My Arm.",
      "actions": [],
      "postconditions": [],
      "jumpconditions": [],
      "jumpOffset": 0,
      "neededItems": [],
      "recommendedItems": []
    },
    {
      "text": "Lift the troll named Big Rock.",
      "actions": [],
      "postconditions": [],
      "jumpconditions": [],
      "jumpOffset": 0,
      "neededItems": [],
      "recommendedItems": []
    },
    {
      "text": "Talk to Pretty Flower .",
      "actions": [
        {
          "t": "conversationHighlight",
          "text": "We want you to help defend Keldagrim from chaos dwarves."
        },
        {
          "t": "conversationHighlight",
          "text": "I'll just be going."
