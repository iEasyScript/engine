      "postconditions": [],
      "jumpconditions": [],
      "jumpOffset": 0,
      "neededItems": [],
      "recommendedItems": []
    },
    {
      "text": "Go to the library north of the Palace in West Keldagrim.",
      "actions": [],
      "postconditions": [],
      "jumpconditions": [],
      "jumpOffset": 0,
      "neededItems": [],
      "recommendedItems": []
    },
    {
      "text": "Talk to Meike or Veldaban.",
