        {
          "t": "conversationHighlight",
          "text": "What about the trolls?"
        },
        {
          "t": "conversationHighlight",
          "text": "[Any option]"
        },
        {
          "t": "conversationHighlight",
          "text": "I'm going to go and talk to them, with or without you."
