        {
          "t": "conversationHighlight",
          "text": "[Any option]"
        },
        {
          "t": "conversationHighlight",
          "text": "Wait, what pretty flower are you talking about?"
        },
        {
          "t": "conversationHighlight",
          "text": "Could I have a pretty flower?"
        },
        {
          "t": "conversationHighlight",
          "text": "I need to give it to Pretty Flower."
        },
        {
          "t": "conversationHighlight",
          "text": "I need to give the plant to the warlord."
        }
