      "postconditions": [],
      "jumpconditions": [],
      "jumpOffset": 0,
      "neededItems": [],
      "recommendedItems": []
    },
    {
      "text": "Head to the King's Axe Inn (Keldagrim West) and talk to Luitger.",
      "actions": [
        {
          "t": "conversationHighlight",
          "text": "You're not joining the protests?"
