      "postconditions": [],
      "jumpconditions": [],
      "jumpOffset": 0,
      "neededItems": [],
      "recommendedItems": []
    },
    {
      "text": "Head back halfway through the cavern until you come to an entrance on the east side. Enter it and speak to Pretty Flower.",
      "actions": [
        {
          "t": "conversationHighlight",
          "text": "I need to talk to you."
        },
        {
          "t": "conversationHighlight",
          "text": "How can I prove I'm worthy?"
