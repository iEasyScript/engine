      "jumpconditions": [],
      "jumpOffset": 0,
      "neededItems": [],
      "recommendedItems": []
    },
    {
      "text": "Talk to Meike.",
      "actions": [],
      "postconditions": [],
      "jumpconditions": [],
      "jumpOffset": 0,
      "neededItems": [],
      "recommendedItems": []
    },
    {
      "text": "Use the furnace (not forge) such as the one in the Palace south of the library, if the prompt doesn't show up go to another furnace.",
