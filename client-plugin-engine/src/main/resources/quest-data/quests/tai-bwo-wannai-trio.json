          "itemId": -1,
          "quantity": 1,
          "duringQuest": false
        }
      ],
      "recommendedItems": []
    },
    {
      "text": "Chop nearby dead trees to get 2 logs to light (or go to the fire south of Tai Bwo Wannai).",
