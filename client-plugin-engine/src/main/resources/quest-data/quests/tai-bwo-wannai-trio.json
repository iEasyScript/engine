      "postconditions": [],
      "jumpconditions": [],
      "jumpOffset": 0,
      "neededItems": [],
      "recommendedItems": []
    },
    {
      "text": "Use the Karambwan (not the Karambwanji) on the fire; select the option poison karambwan.",
