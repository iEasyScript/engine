  "steps": [
    {
      "title": "Food poisoning",
      "text": "Talk to Captain Undak, east of the bank (by the eastern water fountain) in Dorgesh-Kaan. (You must dismiss any follower or pet you have or he will not go with you.)",
      "actions": [
        {
          "t": "conversationHighlight",
          "text": "Can I help with anything?"
        },
        {
          "t": "conversationHighlight",
          "text": "Yes."
        },
        {
          "t": "conversationHighlight",
          "text": "Okay. What's your point?"
        }
      ],
      "postconditions": [
        {
          "t": "questInterfaceOpen"
        }
      ],
      "jumpconditions": [],
      "jumpOffset": 0,
      "neededItems": [],
      "recommendedItems": []
    },
    {
      "text": "[Accept Quest]",
      "actions": [],
      "postconditions": [
        {
          "t": "questStarted"
        }
      ],
      "jumpconditions": [],
      "jumpOffset": 0,
      "neededItems": [],
      "recommendedItems": []
    },
    {
      "text": "Climb the nearby stairs (north) and talk to Mernik in the nursery. She is the adult in the building.",
      "actions": [],
      "postconditions": [],
      "jumpconditions": [],
      "jumpOffset": 0,
      "neededItems": [],
      "recommendedItems": []
    },
    {
      "text": "Talk to Torzek outside.",
      "actions": [
        {
          "t": "conversationHighlight",
          "text": "Calm down. I'm here to help."
        },
        {
          "t": "conversationHighlight",
          "text": "Have the children eaten anything unusual lately?"
        },
        {
          "t": "conversationHighlight",
          "text": "What did they have?"
        }
      ],
      "postconditions": [],
      "jumpconditions": [],
      "jumpOffset": 0,
      "neededItems": [],
      "recommendedItems": []
    },
    {
      "text": "Talk to any nearby child against the building wall about what they ate.<ul><li>Andil:  The chat options may vary from person to person.</li><li>Delgon:</li><li>Gerdi:</li></ul>",
      "actions": [
        {
          "t": "conversationHighlight",
          "text": "What food did you eat yesterday?"
        },
        {
          "t": "conversationHighlight",
          "text": "What food did you have yesterday?"
        },
        {
          "t": "conversationHighlight",
          "text": "What food did you eat yesterday?"
        }
      ],
      "postconditions": [],
      "jumpconditions": [],
      "jumpOffset": 0,
      "neededItems": [],
      "recommendedItems": []
    },
    {
      "text": "Talk to Captain Undak.  (If you are unable to talk with Captain Undak, make sure you do not have 'Hide Familiar options' checked under Settings>Combat & Action Bar>Choose Option Menu and log out and back in)",
      "actions": [
        {
          "t": "conversationHighlight",
          "text": "I've worked out which foods are poisoned."
        }
      ],
      "postconditions": [],
      "jumpconditions": [],
      "jumpOffset": 0,
      "neededItems": [],
      "recommendedItems": []
    },
    {
      "text": "Go down the stairs and head south to the market.",
      "actions": [],
      "postconditions": [],
      "jumpconditions": [],
      "jumpOffset": 0,
      "neededItems": [],
      "recommendedItems": []
    },
    {
      "text": "Talk to Markog, at the south-eastern-most stall of the market.",
      "actions": [
        {
          "t": "conversationHighlight",
          "text": "Which merchants have you bought ingredients from?"
        }
      ],
      "postconditions": [],
      "jumpconditions": [],
      "jumpOffset": 0,
      "neededItems": [],
      "recommendedItems": []
    },
    {
      "text": "Talk to Turgok, at the south-western-most stall of the market.",
      "actions": [
        {
          "t": "conversationHighlight",
          "text": "Which merchants have you bought ingredients from?"
        }
      ],
      "postconditions": [],
      "jumpconditions": [],
      "jumpOffset": 0,
      "neededItems": [],
      "recommendedItems": []
    },
    {
      "text": "Talk to Merchant Walton, just outside of the market to the south-east.",
      "actions": [
        {
          "t": "conversationHighlight",
          "text": "This is the one, Captain."
        },
        {
          "t": "conversationHighlight",
          "text": "Yes, I'm sure."
        },
        {
          "t": "conversationHighlight",
          "text": "[Attack the merchant]"
        },
        {
          "t": "conversationHighlight",
          "text": "What's that behind you?"
        }
      ],
      "postconditions": [],
      "jumpconditions": [],
      "jumpOffset": 0,
      "neededItems": [],
      "recommendedItems": []
    },
    {
      "text": "Proceed to kill the merchant (cannot be ranged).",
      "actions": [],
      "postconditions": [],
      "jumpconditions": [],
      "jumpOffset": 0,
      "neededItems": [],
      "recommendedItems": []
    },
    {
      "title": "Zanik",
      "text": "Talk to Zanik.",
      "actions": [
        {
          "t": "conversationHighlight",
          "text": "[Any option]"
        },
        {
          "t": "conversationHighlight",
          "text": "[Any option]"
        },
        {
          "t": "conversationHighlight",
          "text": "Yes! What happened?"
        }
      ],
      "postconditions": [],
      "jumpconditions": [],
      "jumpOffset": 0,
      "neededItems": [],
      "recommendedItems": []
    },
    {
      "text": "Climb on the goblin south-west of the bowl statue.",
      "actions": [],
      "postconditions": [],
      "jumpconditions": [],
      "jumpOffset": 0,
      "neededItems": [],
      "recommendedItems": []
    },
    {
      "text": "Jump on statues to reach the statue holding the bowl of water.<ul><li>If the jump-on option does not appear, try clicking on the head.</li></ul>",
      "actions": [],
      "postconditions": [],
      "jumpconditions": [],
      "jumpOffset": 0,
      "neededItems": [],
      "recommendedItems": []
    },
    {
      "text": "Continue jumping north and take the crossbow from the ledge.",
      "actions": [],
      "postconditions": [],
      "jumpconditions": [],
      "jumpOffset": 0,
      "neededItems": [],
      "recommendedItems": []
    },
    {
      "text": "Grapple the spear of the north-eastern statue and take the pendant.",
      "actions": [],
      "postconditions": [],
      "jumpconditions": [],
      "jumpOffset": 0,
      "neededItems": [],
      "recommendedItems": []
    },
    {
      "text": "Look into the bowl.",
      "actions": [],
      "postconditions": [],
      "jumpconditions": [],
      "jumpOffset": 0,
      "neededItems": [],
      "recommendedItems": []
    },
    {
      "text": "Enter the western portal (the statues will move out of the way) for a cutscene.",
      "actions": [],
      "postconditions": [],
      "jumpconditions": [],
      "jumpOffset": 0,
      "neededItems": [],
      "recommendedItems": []
    },
    {
      "text": "Continue conversation with Zanik.",
      "actions": [
        {
          "t": "conversationHighlight",
          "text": "Let's go."
        }
      ],
      "postconditions": [],
      "jumpconditions": [],
      "jumpOffset": 0,
      "neededItems": [],
      "recommendedItems": []
    },
    {
      "title": "The council",
      "text": "With Zanik following, go to the north end of Dorgesh-Kaan and up the northern most set of stairs.",
      "actions": [],
      "postconditions": [],
      "jumpconditions": [],
      "jumpOffset": 0,
      "neededItems": [],
      "recommendedItems": []
    },
    {
      "text": "Watch the cutscene.",
      "actions": [
        {
          "t": "conversationHighlight",
          "text": "[Any option]"
        },
        {
          "t": "conversationHighlight",
          "text": "Zanik is right. You should kill him."
        },
        {
          "t": "conversationHighlight",
          "text": "She means well."
        },
        {
          "t": "conversationHighlight",
          "text": "[Any option]"
        }
      ],
      "postconditions": [],
      "jumpconditions": [],
      "jumpOffset": 0,
      "neededItems": [],
      "recommendedItems": []
    },
    {
      "text": "Continue conversation with Captain Undak.",
      "actions": [
        {
          "t": "conversationHighlight",
          "text": "Where should I look?"
        },
        {
          "t": "conversationHighlight",
          "text": "I'll start looking now."
        }
      ],
      "postconditions": [],
      "jumpconditions": [],
      "jumpOffset": 0,
      "neededItems": [],
      "recommendedItems": []
    },
    {
      "text": "Run south of the city, up and over staircases until you reach the agility course. Bring a light source.",
      "actions": [],
      "postconditions": [],
      "jumpconditions": [],
      "jumpOffset": 0,
      "neededItems": [],
      "recommendedItems": []
    },
    {
      "text": "Descend the ladder top and head all the way south.",
      "actions": [],
      "postconditions": [],
      "jumpconditions": [],
      "jumpOffset": 0,
      "neededItems": [],
      "recommendedItems": []
    },
    {
      "text": "Talk to Zanik.",
      "actions": [
        {
          "t": "conversationHighlight",
          "text": "[Sit down next to Zanik.]"
        },
        {
          "t": "conversationHighlight",
          "text": "[Say nothing.]"
        },
        {
          "t": "conversationHighlight",
          "text": "[Say nothing.]"
        },
        {
          "t": "conversationHighlight",
          "text": "[Say nothing.]"
        },
        {
          "t": "conversationHighlight",
          "text": "Yes, but you should have respected the council."
        },
        {
          "t": "conversationHighlight",
          "text": "[Any option]"
        },
        {
          "t": "conversationHighlight",
          "text": "What do you wish had happened?"
        },
        {
          "t": "conversationHighlight",
          "text": "Someday, we'll build that world."
        }
      ],
      "postconditions": [],
      "jumpconditions": [],
      "jumpOffset": 0,
      "neededItems": [],
      "recommendedItems": []
    },
    {
      "text": "Watch the cutscene.",
      "actions": [
        {
          "t": "conversationHighlight",
          "text": "[Any option]"
        },
        {
          "t": "conversationHighlight",
          "text": "I have nothing else to say."
        }
      ],
      "postconditions": [],
      "jumpconditions": [],
      "jumpOffset": 0,
      "neededItems": [],
      "recommendedItems": []
    },
    {
      "text": "After the cutscene talk to Zanik.",
      "actions": [
        {
          "t": "conversationHighlight",
          "text": "Goodbye, Zanik."
        }
      ],
      "postconditions": [],
      "jumpconditions": [],
      "jumpOffset": 0,
      "neededItems": [],
      "recommendedItems": []
    },
    {
      "text": "Talk to Captain Undak for a set of H.A.M. robes.",
      "actions": [
        {
          "t": "conversationHighlight",
          "text": "What is this task?"
        },
        {
          "t": "conversationHighlight",
          "text": "I'll do it."
        }
      ],
      "postconditions": [],
      "jumpconditions": [],
      "jumpOffset": 0,
      "neededItems": [],
      "recommendedItems": []
    },
    {
      "text": "Prepare for battle, but only wear the H.A.M. robes.",
      "actions": [],
      "postconditions": [],
      "jumpconditions": [],
      "jumpOffset": 0,
      "neededItems": [],
      "recommendedItems": []
    },
    {
      "title": "Beef with H.A.M.",
      "text": "Enter the H.A.M. Hideout in Lumbridge forest.",
      "actions": [],
      "postconditions": [],
      "jumpconditions": [],
      "jumpOffset": 0,
      "neededItems": [
        {
          "name": "H.A.M. robe outfit",
          "itemId": -1,
          "quantity": 1,
          "duringQuest": false
        }
      ],
      "recommendedItems": []
    },
    {
      "text": "Talk to Johanhus Ulsbrecht in the centremost of the three southern rooms.<ul><li>Before you do, make sure to wear all of the H.A.M. robes</li></ul>",
      "actions": [
        {
          "t": "conversationHighlight",
          "text": "What are you planning to do about the cave goblins?"
        },
        {
          "t": "conversationHighlight",
          "text": "Isn't Sigmund working with you any more?"
        },
        {
          "t": "conversationHighlight",
          "text": "How can I find Sigmund's base?"
        },
        {
          "t": "conversationHighlight",
          "text": "I'll go there now."
        }
      ],
      "postconditions": [],
      "jumpconditions": [],
      "jumpOffset": 0,
      "neededItems": [],
      "recommendedItems": []
    },
    {
      "text": "Talk to Milton in the windmill near the Fishing Guild, north of the Ardougne lodestone.",
      "actions": [
        {
          "t": "conversationHighlight",
          "text": "I want to get in to Sigmund's base."
        },
        {
          "t": "conversationHighlight",
          "text": "Arrav."
        }
      ],
      "postconditions": [],
      "jumpconditions": [],
      "jumpOffset": 0,
      "neededItems": [],
      "recommendedItems": []
    },
    {
      "text": "Climb down the ladder inside the windmill.",
      "actions": [],
      "postconditions": [],
      "jumpconditions": [],
      "jumpOffset": 0,
      "neededItems": [],
      "recommendedItems": []
    },
    {
      "text": "Run directly east through the door, continuing east through stacks of crates.",
      "actions": [],
      "postconditions": [],
      "jumpconditions": [],
      "jumpOffset": 0,
      "neededItems": [],
      "recommendedItems": []
    },
    {
      "text": "Talk to the guard next to the prison.",
      "actions": [
        {
          "t": "conversationHighlight",
          "text": "I need to see the prisoner."
        },
        {
          "t": "conversationHighlight",
          "text": "Letter?"
        },
        {
          "t": "conversationHighlight",
          "text": "What day is it today?"
        },
        {
          "t": "conversationHighlight",
          "text": "Never mind."
        }
      ],
      "postconditions": [],
      "jumpconditions": [],
      "jumpOffset": 0,
      "neededItems": [],
      "recommendedItems": []
    },
    {
      "text": "Enter the main area (back through the doors to the west) and pickpocket Sam.",
      "actions": [],
      "postconditions": [],
      "jumpconditions": [],
      "jumpOffset": 0,
      "neededItems": [],
      "recommendedItems": []
    },
    {
      "text": "Return to the prison guard.",
      "actions": [
        {
          "t": "conversationHighlight",
          "text": "I have my letter here."
        }
      ],
      "postconditions": [],
      "jumpconditions": [],
      "jumpOffset": 0,
      "neededItems": [],
      "recommendedItems": []
    },
    {
      "text": "Enter the prison and take the key, open the gate.",
      "actions": [],
      "postconditions": [],
      "jumpconditions": [],
      "jumpOffset": 0,
      "neededItems": [],
      "recommendedItems": []
    },
    {
      "text": "Escape with Grubfoot:<ul><li>Talk to the prisoner, Grubfoot.</li><li>Run into the kitchen, squeeze through the hole.</li><li>Open 1 of the 2 doors.</li><li>Go back through and open the other door as well.</li><li>Return to Grubfoot.</li><li>Stand north of the guard, talk to him to face you and have his back turned. After selecting the chat option, do not continue the conversation until Grubfoot walks past the guard into the next room.</li><li>Talk to Grubfoot in the next room.</li><li>Squeeze into the kitchen. Take the dirty plates from the sink, and wait for the H.A.M. guard to come talk to you.</li><li>Talk to Grubfoot in the bedroom.</li><li>Exit the east door and run to the big doors north.</li></ul>",
      "actions": [
        {
          "t": "conversationHighlight",
          "text": "Wait there. I'll come back for you."
        },
        {
          "t": "conversationHighlight",
          "text": "Let's go"
        },
        {
          "t": "conversationHighlight",
          "text": "I'll distract the guard so you can make a break for it."
        },
        {
          "t": "conversationHighlight",
          "text": "[Any option]"
        },
        {
          "t": "conversationHighlight",
          "text": "Wait at the west door; I'll distract the guard."
        },
        {
          "t": "conversationHighlight",
          "text": "Yes."
        },
        {
          "t": "conversationHighlight",
          "text": "[Any option]"
        },
        {
          "t": "conversationHighlight",
          "text": "Follow me."
        },
        {
          "t": "conversationHighlight",
          "text": "Let's get out of here."
        }
      ],
      "postconditions": [],
      "jumpconditions": [],
      "jumpOffset": 0,
      "neededItems": [],
      "recommendedItems": []
    },
    {
      "text": "Watch the cutscene and wait for Sigmund to confront you.",
      "actions": [
        {
          "t": "conversationHighlight",
          "text": "Time for you to die!"
        }
      ],
      "postconditions": [],
      "jumpconditions": [],
      "jumpOffset": 0,
      "neededItems": [],
      "recommendedItems": []
    },
    {
      "text": "Kill Sigmund.<ul><li>If Zanik doesn't attack Sigmund, climb up the ladder, then back down.</li></ul>",
      "actions": [
        {
          "t": "conversationHighlight",
          "text": "[Any option]"
        }
      ],
      "postconditions": [],
      "jumpconditions": [],
      "jumpOffset": 0,
      "neededItems": [],
      "recommendedItems": []
    },
    {
      "text": "Kill Zanik repeatedly.<ul><li>Turn off revolution in combat settings and avoid using bleeds and channelled abilities as they cancel the dialogue forcing you to repeat the phase.</li><li>If revolution was left on and dialogue interrupted, run up and then down the ladder to the west to avoid having to fight again.</li></ul>",
      "actions": [
        {
          "t": "conversationHighlight",
          "text": "I won't kill you, Zanik."
        },
        {
          "t": "conversationHighlight",
          "text": "Zanik! What's happened to you?"
        },
        {
          "t": "conversationHighlight",
          "text": "Does our friendship mean nothing to you?"
        },
        {
          "t": "conversationHighlight",
          "text": "But am I *your* enemy?"
        },
        {
          "t": "conversationHighlight",
          "text": "Zanik, you're being controlled. Fight it!"
        },
        {
          "t": "conversationHighlight",
          "text": "Zanik, it's the pendant. Take it off!"
        },
        {
          "t": "conversationHighlight",
          "text": "You've got to do it, otherwise it will win!"
        }
      ],
      "postconditions": [],
      "jumpconditions": [],
      "jumpOffset": 0,
      "neededItems": [],
      "recommendedItems": []
    },
    {
      "title": "Lumbridge caves",
      "text": "Run west for an earthquake.",
      "actions": [],
      "postconditions": [],
      "jumpconditions": [],
      "jumpOffset": 0,
      "neededItems": [],
      "recommendedItems": []
    },
    {
      "text": "Right click Clear the fallen rocks.",
      "actions": [],
      "postconditions": [],
      "jumpconditions": [],
      "jumpOffset": 0,
      "neededItems": [],
      "recommendedItems": []
    },
    {
      "text": "Talk to Zanik.",
      "actions": [
        {
          "t": "conversationHighlight",
          "text": "Try grappling across with your crossbow."
        },
        {
          "t": "conversationHighlight",
          "text": "I can see somewhere it could catch."
        },
        {
          "t": "conversationHighlight",
          "text": "Right a bit."
        },
        {
          "t": "conversationHighlight",
          "text": "Right a bit."
        },
        {
          "t": "conversationHighlight",
          "text": "You've overshot. Go left."
        },
        {
          "t": "conversationHighlight",
          "text": "It's alright, Zanik. You can do it."
        },
        {
          "t": "conversationHighlight",
          "text": "Just a bit further left."
        },
        {
          "t": "conversationHighlight",
          "text": "I'm not leaving you, Zanik."
        }
      ],
      "postconditions": [],
      "jumpconditions": [],
      "jumpOffset": 0,
      "neededItems": [],
      "recommendedItems": []
    },
    {
      "text": "Go through the cave and talk to Juna.",
      "actions": [],
      "postconditions": [],
      "jumpconditions": [],
      "jumpOffset": 0,
      "neededItems": [],
      "recommendedItems": []
    },
    {
      "text": "Run north-west to exit the cave.",
      "actions": [],
      "postconditions": [],
      "jumpconditions": [],
      "jumpOffset": 0,
      "neededItems": [],
      "recommendedItems": []
    },
    {
      "text": "Go over the stepping stones and run directly north.",
      "actions": [],
      "postconditions": [],
      "jumpconditions": [],
      "jumpOffset": 0,
      "neededItems": [],
      "recommendedItems": []
    },
    {
      "text": "Squeeze through the hole.<ul><li>If you don't have the shortcut unlocked, you'll have to go all the way around towards Lumbridge Castle's Cellar.</li><li>If at any point Zanik stops following you, she can be found back at Juna.</li></ul>",
      "actions": [],
      "postconditions": [],
      "jumpconditions": [],
      "jumpOffset": 0,
      "neededItems": [],
      "recommendedItems": []
    },
    {
      "text": "Right click Follow Kazgar.",
      "actions": [
        {
          "t": "conversationHighlight",
          "text": "Dorgeshuun Mines"
        }
      ],
      "postconditions": [],
      "jumpconditions": [],
      "jumpOffset": 0,
      "neededItems": [],
      "recommendedItems": []
    },
