      "postconditions": [],
      "jumpconditions": [],
      "jumpOffset": 0,
      "neededItems": [],
      "recommendedItems": []
    },
    {
      "text": "Continue north and dispatch the next guard (2).",
      "actions": [],
      "postconditions": [],
      "jumpconditions": [],
      "jumpOffset": 0,
      "neededItems": [],
      "recommendedItems": []
    },
    {
      "text": "Stand in the doorway to the main hallway and wait for the guard (3) to come to you and dispatch him (watch for the shadow on the floor).",
