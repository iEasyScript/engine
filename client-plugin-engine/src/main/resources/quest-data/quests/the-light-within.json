      "neededItems": [],
      "recommendedItems": []
    },
    {
      "title": "Naturalist shard",
      "text": "Talk to Coeden, the living tree surrounded by ivy in the Crwys Clan district.",
      "actions": [
        {
          "t": "conversationHighlight",
          "text": "The Light Within."
