{
  "mcpServers": {
    "ghidra": {
      "command": "python",
      "args": [
        "ghidra-mcp/bridge_mcp_ghidra.py",
        "--base-port",
        "8080",
        "--port-range",
        "10"
      ]
    },
    "projectx": {
      "type": "sse",
      "url": "http://localhost:7882/"
    },
    "gitlab": {
      "command": "npx",
      "args": [
        "-y",
        "@zereight/mcp-gitlab"
      ],
      "env": {
        "GITLAB_USE_OAUTH": "true",
        "GITLAB_OAUTH_CLIENT_ID": "84d55e4e563a935a35874c8c9e1c3cd4e17b6d77bdc7f068482e0be3dacc525f",
        "GITLAB_OAUTH_REDIRECT_URI": "http://127.0.0.1:8888/callback",
        "GITLAB_API_URL": "https://gitlab.com/api/v4",
        "GITLAB_PROJECT_ID": "62439376",
        "GITLAB_ALLOWED_PROJECT_IDS": "62439376,62439364,82384922",
        "GITLAB_READ_ONLY_MODE": "false",
        "USE_GITLAB_WIKI": "false",
        "USE_MILESTONE": "false",
        "USE_PIPELINE": "false"
      }
    },
    "rs3-data": {
      "type": "http",
      "url": "https://rs3-data.projectx.org/mcp",
      "headers": {
        "Authorization": "Bearer ${PROJECTX_DATA_TOKEN}"
      },
      "timeout": 900000
    }
  }
}
