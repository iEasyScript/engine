# JS5 RSA (4096-bit) — signs the master index / version table
RSA_JS5_
RSA_JS5_

# Login/world RSA (1024-bit) — login block encryption
RSA_LOGIN_
RSA_LOGIN_
RSA_WORLD_
RSA_WORLD_

# Root data dir for local, configurable content (cache, authored settings + npc combat/drop defs).
DATA_PATH=./data
CACHE_PATH=./data/cache

# Hex RSA moduli for the LD_PRELOAD patcher (libprojectx_patcher.so)
# Login RSA (1024-bit, 256 hex chars) — patches rs2client login key
PROJECTX_RSA_MODULUS=9eb6433eeb945284a41a466d7b1d33b2a05b7382c72211a68ebecfe1bdaa1130281797e611a1fd85d4de4a2bc50a7381cdb3c837b9b5abb0ec7ab3fb550119356cd69f7447a6724011c1f2ffc621af76d302cc0b6da59525a7a4234f755ede053edb010a20d07f8aa48e8a63a9eb12486487e2751d36c106f80015d8da5bc8b3
# JS5 RSA (4096-bit, 1024 hex chars) — patches rs2client version table key
PROJECTX_JS5_RSA_

PROJECTX_HTTP_PORT=8829

# Server bind + advertised hosts.
#   Loopback dev (default): leave unset -> lobby 127.0.0.1, world 127.0.0.2, advertise 127.0.0.1.
#   LAN / external clients: set PUBLIC_HOST + LOBBY_HOST to this machine's LAN IP and give the
#   world a SECOND LAN IP (lobby and world share the game port and are split only by HOST, since
#   the client computes/ignores the world port). Alias it first, e.g.:
#     sudo ip addr add 10.69.69.51/24 dev enp2s0
# PUBLIC_HOST=10.69.69.50        # advertised in jav_config (codebase, JS5, lobby game host)
# LOBBY_HOST=10.69.69.50         # lobby bind address
# WORLD_HOST=10.69.69.51         # world bind address (2nd LAN IP)
# WORLD_PUBLIC_HOST=10.69.69.51  # world host advertised to the client (defaults to WORLD_HOST)

# true -> local dev: the built-in dev defaults for the secrets below are accepted.
# false -> production: every secret must be set explicitly or startup fails.
DEBUG=true

# Dev auth tokens (required since fail-fast secret validation; same values as old in-source defaults)
SOCIAL_GATEWAY_TOKEN=projectx-gateway-dev-token
WORLD_LOGIN_TOKEN_SECRET=projectx-world-login-dev-secret

# true -> use a crazy-basic in-process account store (no MongoDB install needed); ignores MONGO_URI.
# false -> connect to a real MongoDB at MONGO_URI. (Legacy alias for this flag: EMBEDDED_MONGO.)
MONGO_IN_MEMORY=true
